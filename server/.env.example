# ── Required ─────────────────────────────────────────────────────────────
# Xendit TEST secret key: Xendit dashboard (Test mode) > Settings > API keys.
# Give the key write access to "Money-in" (Invoices). It starts with xnd_development_
XENDIT_SECRET_KEY=xnd_development_replace_me

# Firebase Admin credentials: Firebase console > Project settings > Service accounts
# > Generate new private key. Save the JSON next to this file (it is git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── Recommended ──────────────────────────────────────────────────────────
# Where Xendit sends people after they pay. "localhost" only works on this computer.
# For a real phone use your computer's Wi-Fi address (http://192.168.x.x:4000) or an ngrok URL.
PUBLIC_BASE_URL=http://localhost:4000

# ── Optional ─────────────────────────────────────────────────────────────
PORT=4000

# Only if you point Xendit's webhook at this server (needs a public URL such as ngrok).
# Xendit dashboard > Settings > Webhooks > "Invoices paid" > callback URL + verification token.
# The webhook URL is:  <public url>/api/xendit/webhook
XENDIT_CALLBACK_TOKEN=

# Smallest single payment to allow, in pesos. Xendit also enforces minimums per payment channel.
MIN_PAYMENT=100

# How long an invoice stays payable, in seconds (86400 = 24 hours).
INVOICE_DURATION_SECONDS=86400

# Comma-separated web origins allowed to call this server. Empty = anyone (fine for local testing).
# Example: http://localhost:8081,https://myapp.example.com
ALLOWED_ORIGINS=
